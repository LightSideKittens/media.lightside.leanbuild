.leanbuild {
    --lb-radius: 8px;
    --lb-pad: 20px;
    --lb-block: 14px;
    --lb-attached: 8px;
    --lb-caption: 6px;
    font-size: 13px;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.leanbuild--dark {
    --lb-surface: rgb(44, 44, 44);
    --lb-control: rgb(57, 57, 57);
    --lb-control-hover: rgb(66, 66, 66);
    --lb-text: rgb(220, 222, 225);
    --lb-muted: rgba(220, 222, 225, 0.72);
    --lb-accent: rgb(120, 175, 130);
    --lb-accent-hover: rgb(139, 194, 149);
    --lb-accent-text: rgb(40, 40, 40);
    --lb-idle-border: rgba(120, 175, 130, 0);
    --lb-warn: rgb(255, 204, 51);
    --lb-warn-soft: rgba(255, 204, 51, 0.11);
}

.leanbuild--light {
    --lb-surface: rgb(253, 253, 253);
    --lb-control: rgb(224, 224, 224);
    --lb-control-hover: rgb(235, 235, 235);
    --lb-text: rgb(42, 44, 48);
    --lb-muted: rgba(42, 44, 48, 0.72);
    --lb-accent: rgb(57, 87, 63);
    --lb-accent-hover: rgb(48, 74, 53);
    --lb-accent-text: rgb(244, 245, 246);
    --lb-idle-border: rgba(57, 87, 63, 0);
    --lb-warn: rgb(99, 77, 13);
    --lb-warn-soft: rgba(99, 77, 13, 0.11);
}

.leanbuild__page {
    padding: 0 var(--lb-pad) var(--lb-block) 4px;
}

.leanbuild__card,
.leanbuild__title,
.leanbuild__lead,
.leanbuild__empty,
.leanbuild__note,
.leanbuild__toggle,
.leanbuild__drop,
.leanbuild__wide,
.leanbuild__list,
.leanbuild__patch,
.leanbuild__row {
    flex-shrink: 0;
}

.leanbuild__card {
    margin: var(--lb-block) 0 0 0;
    padding: 16px var(--lb-pad);
    background-color: var(--lb-surface);
    border-radius: var(--lb-radius);
}

.leanbuild__title {
    margin: 0;
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--lb-text);
    white-space: normal;
}

.leanbuild__lead {
    margin: var(--lb-caption) 0 0 0;
    color: var(--lb-muted);
    white-space: normal;
}

.leanbuild__empty {
    margin: var(--lb-block) 0 0 0;
    color: var(--lb-muted);
    white-space: normal;
}

.leanbuild__note {
    margin: var(--lb-attached) 0 0 0;
    padding: 9px 12px;
    color: var(--lb-warn);
    background-color: var(--lb-warn-soft);
    border-radius: var(--lb-radius);
    white-space: normal;
}

.leanbuild__toggle {
    margin: var(--lb-block) 0 0 0;
    min-height: 24px;
}

.leanbuild__text {
    margin-left: 2px;
    color: var(--lb-text);
    white-space: normal;
    flex-shrink: 1;
}

.leanbuild__input {
    flex-grow: 1;
}

.leanbuild__checkmark {
    position: relative;
    align-items: center;
    justify-content: center;
    width: 16px;
    min-width: 16px;
    height: 16px;
    min-height: 16px;
    margin-right: 5px;
    padding: 0;
    background-image: none;
    background-color: var(--lb-control);
    border-width: 1px;
    border-color: var(--lb-idle-border);
    border-radius: 5px;
    transition-property: background-color, border-left-color, border-right-color, border-top-color, border-bottom-color;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

.leanbuild__toggle:hover:enabled .leanbuild__checkmark {
    background-color: var(--lb-control-hover);
    border-color: var(--lb-accent);
}

.leanbuild__toggle:checked .leanbuild__checkmark,
.leanbuild__input:checked > .leanbuild__checkmark {
    background-color: var(--lb-accent);
    border-color: var(--lb-accent);
}

.leanbuild__toggle:checked:hover:enabled .leanbuild__checkmark,
.leanbuild__toggle:hover:enabled .leanbuild__input:checked > .leanbuild__checkmark {
    background-color: var(--lb-accent-hover);
    border-color: var(--lb-accent-hover);
}

.leanbuild__mark {
    position: relative;
    width: 12px;
    min-width: 12px;
    height: 12px;
    min-height: 12px;
    flex-shrink: 0;
    opacity: 0;
}

.leanbuild__toggle:checked .leanbuild__mark {
    opacity: 1;
}

.leanbuild__mark-short,
.leanbuild__mark-long {
    position: absolute;
    height: 2px;
    background-color: var(--lb-accent-text);
    border-radius: 1px;
    transform-origin: center;
}

.leanbuild__mark-short {
    left: 1px;
    top: 6px;
    width: 5px;
    rotate: 45deg;
}

.leanbuild__mark-long {
    left: 3px;
    top: 5px;
    width: 8px;
    rotate: -45deg;
}

.leanbuild__drop {
    margin: var(--lb-block) 0 0 0;
    padding: 18px 12px;
    color: var(--lb-muted);
    background-color: var(--lb-control);
    border-width: 1px;
    border-color: var(--lb-accent);
    border-radius: var(--lb-radius);
    white-space: normal;
    -unity-text-align: middle-center;
}

.leanbuild__wide {
    margin: var(--lb-block) 0 0 0;
    padding: 7px 12px;
    color: var(--lb-text);
    background-color: var(--lb-control);
    border-width: 1px;
    border-color: var(--lb-idle-border);
    border-radius: var(--lb-radius);
}

.leanbuild__wide:hover:enabled {
    background-color: var(--lb-control-hover);
    border-color: var(--lb-accent);
}

.leanbuild__list {
    margin: 0;
}

.leanbuild__patch {
    margin: var(--lb-block) 0 0 0;
    padding: 10px 12px;
    background-color: var(--lb-control);
    border-radius: var(--lb-radius);
}

.leanbuild__row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    min-height: 22px;
    margin: 0;
    padding: 0;
}

.leanbuild__row--file {
    margin: var(--lb-caption) 0 0 0;
}

.leanbuild__subtitle {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 8px 0 0;
    color: var(--lb-text);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.leanbuild__file {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 8px 0 14px;
    font-size: 12px;
    color: var(--lb-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: start;
}

.leanbuild__remove {
    width: 22px;
    min-width: 22px;
    height: 20px;
    flex-shrink: 0;
    align-self: center;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: rgba(204, 38, 41, 0.14);
    color: rgb(224, 115, 115);
}

.leanbuild__remove:hover:enabled {
    background-color: rgba(214, 64, 64, 0.30);
}

.leanbuild__action {
    width: 22px;
    min-width: 22px;
    height: 20px;
    flex-shrink: 0;
    align-self: center;
    margin: 0 4px 0 0;
    padding: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: var(--lb-control-hover);
    color: var(--lb-muted);
}

.leanbuild__action:hover:enabled {
    color: var(--lb-accent);
}
